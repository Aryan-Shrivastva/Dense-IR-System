# Copy this to .env and fill in values
CORPUS_SIZE=50000
INDEX_PATH=indexes/faiss_index.bin
BM25_PATH=indexes/bm25_index.pkl
CORPUS_PATH=indexes/corpus.pkl
DB_PATH=data/userdata.db
MODEL_NAME=all-MiniLM-L6-v2
COLBERT_MODEL=bert-base-uncased
TOP_K_STAGE1=100
TOP_K_STAGE2=20
TOP_K_FINAL=10
EMA_DECAY=0.85
ALPHA_MIN=0.3
ALPHA_MAX=0.9

# Set to 1 when Hugging Face is blocked (corporate SSL/403). Uses hash bi-encoder + ColBERT stub.
OFFLINE_IR=0

# --- Wikipedia corpus (optional) ---
# If you already have Wikipedia downloaded via save_to_disk() (e.g. on a GPU server),
# set this to skip the HuggingFace download in download_wikipedia.py.
# Example: WIKI_DISK_PATH=/home/user/wiki_project/wikipedia_full
WIKI_DISK_PATH=

# Number of Wikipedia articles to process (default 20000)
WIKI_SIZE=20000
