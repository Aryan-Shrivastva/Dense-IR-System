# Copy this to .env and fill in values
CORPUS_SIZE=50000
INDEX_PATH=indexes/faiss_index.bin
BM25_PATH=indexes/bm25_index.pkl
CORPUS_PATH=indexes/corpus.pkl
DB_PATH=data/userdata.db
